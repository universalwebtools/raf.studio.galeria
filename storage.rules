rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Klient czyta pliki galerii tylko po poprawnym haśle: Cloud Function
    // galleryAccess dopisuje slug galerii do custom claim "g" w jego tokenie.
    match /galleries/{galleryId}/{allPaths=**} {
      allow read: if request.auth != null
                  && (request.auth.uid == "NLYAfU5UNcfldH4k2x2r9m1g4Vx1"
                      || galleryId in request.auth.token.get("g", []));
      allow write: if request.auth != null
                   && request.auth.uid == "NLYAfU5UNcfldH4k2x2r9m1g4Vx1";
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
